DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=gregport
DB_PORT=5432
APP_PORT=8080
LOG_LEVEL=info
JWT_SECRET=replace-me-with-32-plus-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379
REDIS_DIAL_TIMEOUT=1s
REDIS_READ_TIMEOUT=500ms
REDIS_WRITE_TIMEOUT=500ms
CACHE_TIMEOUT=200ms
CACHE_TTL_SETTINGS=5m
CACHE_TTL_SLA_POLICIES=5m
CACHE_TTL_DASHBOARD_COUNTS=45s
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
PUBLIC_RATE_LIMIT_REQUESTS=30
PUBLIC_RATE_LIMIT_WINDOW=1m
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW=15m
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
IDEMPOTENCY_TTL=24h

# Signs the public satisfaction-rating links in solved-ticket email. Use at
# least 32 random bytes and keep it separate from JWT_SECRET.
RATING_TOKEN_SECRET=replace-me-with-32-plus-random-bytes
RATING_TOKEN_TTL=720h
PUBLIC_APP_URL=http://localhost:8080
RATING_RATE_LIMIT_REQUESTS=5
RATING_RATE_LIMIT_WINDOW=15m

WORKER_PORT=8081
WORKER_CONCURRENCY=20
WORKER_CPU_CONCURRENCY=4
WORKER_SHUTDOWN_TIMEOUT=30s
WORKER_READ_HEADER_TIMEOUT=5s
WORKER_READ_TIMEOUT=10s
WORKER_WRITE_TIMEOUT=10s
WORKER_IDLE_TIMEOUT=60s
WORKER_OUTBOX_INTERVAL=1s
WORKER_OUTBOX_BATCH=100
WORKER_QUEUE_STATS_INTERVAL=1m
SLA_BREACH_CHECK_INTERVAL=1m
SLA_BREACH_CHECK_BATCH=100
AUTO_CLOSE_WINDOW=168h
AUTO_CLOSE_CHECK_INTERVAL=1h
AUTO_CLOSE_CHECK_BATCH=100
HOUSEKEEPING_INTERVAL=1h
HOUSEKEEPING_BATCH=100
TICKET_EVENT_RETENTION=720h
AUDIT_LOG_RETENTION=2160h
EMAIL_DELIVERY_RETENTION=720h
ASYNQMON_PORT=8082

SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
SMTP_FROM_NAME=Gregport

# Elasticsearch is derived search data; Postgres remains the source of truth.
# Security is disabled for local development only. Set either an API key or a
# username/password pair when the cluster requires authentication.
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=tickets
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_TIMEOUT=3s
