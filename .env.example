DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=gregport
DB_PORT=5432
APP_PORT=8080
LOG_LEVEL=info
JWT_SECRET=replace-me-with-32-plus-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

# Real-time Server-Sent Events. Tokens are single-use and short-lived; the
# heartbeat keeps proxies from closing an idle stream.
STREAM_TOKEN_TTL=30s
STREAM_HEARTBEAT_INTERVAL=20s
STREAM_BUFFER_SIZE=64
STREAM_REPLAY_BATCH=200
TYPING_INDICATOR_TTL=5s

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PORT=6379
REDIS_DIAL_TIMEOUT=1s
REDIS_READ_TIMEOUT=500ms
REDIS_WRITE_TIMEOUT=500ms
CACHE_TIMEOUT=200ms
CACHE_TTL_SETTINGS=5m
CACHE_TTL_SLA_POLICIES=5m
CACHE_TTL_DASHBOARD_COUNTS=45s
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
PUBLIC_RATE_LIMIT_REQUESTS=30
PUBLIC_RATE_LIMIT_WINDOW=1m
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW=15m
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
IDEMPOTENCY_TTL=24h

# Signs the public satisfaction-rating links in solved-ticket email. Use at
# least 32 random bytes and keep it separate from JWT_SECRET.
RATING_TOKEN_SECRET=replace-me-with-32-plus-random-bytes
RATING_TOKEN_TTL=720h
PUBLIC_APP_URL=http://localhost:8080
RATING_RATE_LIMIT_REQUESTS=5
RATING_RATE_LIMIT_WINDOW=15m

WORKER_PORT=8081
WORKER_CONCURRENCY=20
WORKER_CPU_CONCURRENCY=4
WORKER_SHUTDOWN_TIMEOUT=30s
WORKER_READ_HEADER_TIMEOUT=5s
WORKER_READ_TIMEOUT=10s
WORKER_WRITE_TIMEOUT=10s
WORKER_IDLE_TIMEOUT=60s
WORKER_OUTBOX_INTERVAL=1s
WORKER_OUTBOX_BATCH=100
WORKER_QUEUE_STATS_INTERVAL=1m
SLA_BREACH_CHECK_INTERVAL=1m
SLA_BREACH_CHECK_BATCH=100
AUTO_CLOSE_WINDOW=168h
AUTO_CLOSE_CHECK_INTERVAL=1h
AUTO_CLOSE_CHECK_BATCH=100
HOUSEKEEPING_INTERVAL=1h
HOUSEKEEPING_BATCH=100
TICKET_EVENT_RETENTION=720h
AUDIT_LOG_RETENTION=2160h
EMAIL_DELIVERY_RETENTION=720h
ASYNQMON_PORT=8082

SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
SMTP_FROM_NAME=Gregport

# Elasticsearch is derived search data; Postgres remains the source of truth.
# Security is disabled for local development only. Set either an API key or a
# username/password pair when the cluster requires authentication.
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=tickets
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_TIMEOUT=3s

# Internal observability listeners. Never publish these ports through a
# reverse proxy or the public load balancer.
METRICS_PORT=9091
WORKER_METRICS_PORT=9092
PPROF_ENABLED=false
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
JAEGER_UI_PORT=16686
OTEL_HTTP_PORT=4318

# Tracing is opt-in. Inside compose the endpoint is http://jaeger:4318.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_INSECURE=true
OTEL_SERVICE_NAME=gregport-api
OTEL_SAMPLE_RATIO=1

APP_ENV=development
# Comma-separated exact origins. Empty disables CORS; "*" allows any origin.
CORS_ALLOWED_ORIGINS=
MAX_REQUEST_BYTES=1048576

# bcrypt cost for new password hashes (10-15). Existing hashes keep their cost.
BCRYPT_COST=12

# Keep DB_MAX_CONNS * instances below Postgres max_connections, with headroom
# for migrations and the worker.
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
WORKER_DB_MAX_CONNS=10
WORKER_DB_MIN_CONNS=1
