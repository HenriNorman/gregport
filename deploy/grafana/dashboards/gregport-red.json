{
  "uid": "gregport-red",
  "title": "Gregport API - RED",
  "tags": ["gregport", "red"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route (req/s)",
      "datasource": { "type": "prometheus", "uid": "gregport-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(gregport_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (5xx / total)",
      "datasource": { "type": "prometheus", "uid": "gregport-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gregport_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(gregport_http_requests_total[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "datasource": { "type": "prometheus", "uid": "gregport-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gregport_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gregport_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gregport_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "In-flight requests",
      "datasource": { "type": "prometheus", "uid": "gregport-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "gregport_http_requests_in_flight", "legendFormat": "in flight" },
        { "refId": "B", "expr": "gregport_sse_connections", "legendFormat": "SSE connections" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Database pool",
      "datasource": { "type": "prometheus", "uid": "gregport-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "gregport_db_pool_acquired_conns", "legendFormat": "acquired {{pool}}" },
        { "refId": "B", "expr": "gregport_db_pool_idle_conns", "legendFormat": "idle {{pool}}" },
        { "refId": "C", "expr": "gregport_db_pool_total_conns", "legendFormat": "total {{pool}}" },
        { "refId": "D", "expr": "gregport_db_pool_max_conns", "legendFormat": "max {{pool}}" },
        { "refId": "E", "expr": "rate(gregport_db_pool_empty_acquire_total[5m])", "legendFormat": "waited acquisitions/s {{pool}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queue depth by state",
      "datasource": { "type": "prometheus", "uid": "gregport-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (queue) (gregport_queue_depth)", "legendFormat": "{{queue}}" },
        { "refId": "B", "expr": "sum(gregport_queue_archived)", "legendFormat": "dead letter" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "datasource": { "type": "prometheus", "uid": "gregport-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(gregport_cache_hits_total[5m]) / clamp_min(rate(gregport_cache_hits_total[5m]) + rate(gregport_cache_misses_total[5m]), 0.001)",
          "legendFormat": "hit ratio"
        },
        { "refId": "B", "expr": "rate(gregport_cache_errors_total[5m])", "legendFormat": "errors/s" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Rate-limit rejections",
      "datasource": { "type": "prometheus", "uid": "gregport-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(gregport_rate_limit_rejected_total[5m])", "legendFormat": "rejected/s" },
        { "refId": "B", "expr": "rate(gregport_rate_limit_errors_total[5m])", "legendFormat": "limiter errors/s" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Job outcomes by task type",
      "datasource": { "type": "prometheus", "uid": "gregport-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (type, outcome) (rate(gregport_jobs_processed_total[5m]))", "legendFormat": "{{type}} {{outcome}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Webhook deliveries",
      "datasource": { "type": "prometheus", "uid": "gregport-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(gregport_webhook_deliveries_total[5m]))", "legendFormat": "{{result}}" }
      ]
    }
  ]
}
